# Copy to .env and fill in. NEVER commit .env.
#
# NVIDIA NIM (OpenAI-compatible) - default provider
NVIDIA_API_KEY=
# Optional: override the model
# EES_LLM_MODEL=stepfun-ai/step-5-preview

# Anthropic (optional alternate provider)
ANTHROPIC_API_KEY=

# Force a provider regardless of config.yaml
# EES_LLM_PROVIDER=nvidia
